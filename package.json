{
  "name": "training-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:check": "node tools/ui-harness/shoot.mjs --check --no-shots",
    "tauri": "tauri",
    "build:release": "tauri build --features production --config '{\"identifier\":\"com.training-app\",\"app\":{\"windows\":[{\"title\":\"Training App\",\"width\":1280,\"height\":800,\"minWidth\":800,\"minHeight\":600,\"resizable\":true}]}}'"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "22.20.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "echarts": "^6.0.0"
  }
}
